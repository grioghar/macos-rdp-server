<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent (NOT a LaunchDaemon). Runs in the logged-in user's GUI (Aqua)
  session, which is REQUIRED for screen capture: a system-context LaunchDaemon
  has no WindowServer connection, so CGDisplayStreamCreate fails. As a per-user
  agent it also picks up the user's Screen Recording / Accessibility grants.

  Because it runs as the user (not root), the TLS cert/key must be readable by
  that user — RDP_CERT_DIR points at a user-owned copy.
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.macosrdp.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/macos-rdp-daemon</string>
        <string>--port</string><string>3389</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RDP_CERT_DIR</key><string>__CERT_DIR__</string>
        <key>RDP_LOG_LEVEL</key><string>verbose</string>
    </dict>
    <key>StandardOutPath</key><string>__LOG_DIR__/macos-rdp-agent.log</string>
    <key>StandardErrorPath</key><string>__LOG_DIR__/macos-rdp-agent.error.log</string>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
    <!-- Run only in the foreground Aqua session so capture/input target the
         active desktop. -->
    <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
