+	 * send paths all use ">="; this one used ">", an off-by-one that indexes
+	 * client_formats[num_client_formats] (out-of-bounds read) when the two are
+	 * equal. */
+	if (context->selected_client_format >= context->num_client_formats)
 		return ERROR_INTERNAL_ERROR;
 
